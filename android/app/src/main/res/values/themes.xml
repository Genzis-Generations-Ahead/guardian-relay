<resources>
    <!-- Framework theme: the core has no AndroidX/Material dependency.
         Compose draws its own Material 3 surfaces on top of this, so it stays the base
         theme for every activity — including the untouched v0.2 debug console. -->
    <style name="Theme.GuardianRelay" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- LaunchActivity has no UI: it routes to the calculator lock or to the app.
         A translucent, animation-free window means no white flash on the way through. -->
    <style name="Theme.Guardian.Launch" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <!-- Public Deterrent Mode: edge-to-edge red, no title, and black animations so the
         screen snaps to red instead of fading in. -->
    <style name="Theme.Guardian.Deterrent" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#B3001F</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:navigationBarColor">#B3001F</item>
        <item name="android:statusBarColor">#B3001F</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#37474F</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="RowBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
